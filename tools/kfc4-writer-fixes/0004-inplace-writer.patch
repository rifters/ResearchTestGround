+fn resource_bounds(file: &KFCFile) -> Vec<u64> {
+    let mut bounds = file.resources()
+        .values()
+        .iter()
+        .map(|entry| entry.offset)
+        .collect::<Vec<_>>();
+
+    let data_end = file.resource_chunks()
+        .iter()
+        .map(|chunk| chunk.uncompressed_offset + chunk.uncompressed_size)
+        .max()
+        .unwrap_or(0);
